# Dockerfile for Hiver AI Customer Support Agent Backend REST API
FROM python:3.11-slim

# Prevent Python from writing bytecode and buffer stdout/stderr
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src:/app

WORKDIR /app

# Install system utilities (curl for readiness probes)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy Python application code, scripts, configs, and minimum required runtime data
COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY configs/ /app/configs/
COPY data/golden/ /app/data/golden/
COPY data/processed/faiss_index_15k/ /app/data/processed/faiss_index_15k/

# Expose backend port
EXPOSE 8000

# Run Uvicorn production server
CMD ["uvicorn", "hiver_agent.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
