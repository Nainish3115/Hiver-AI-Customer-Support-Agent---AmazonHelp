# Environment variables template for Hiver Support Agent
ENVIRONMENT=development

# Target Brand Selection
TARGET_BRAND=AmazonHelp

# Allowed CORS Origins for Frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini LLM API Key (Optional: Leave empty to run with deterministic/mock fallback)
GEMINI_API_KEY=your_gemini_api_key_here
